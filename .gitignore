*.duckdb
*.db
*.db.wal

# Node dependencies
node_modules/

# Python caches and virtual environments
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
# Interpreter created by scripts/build_context_index.sh when the pipeline deps
# are not importable (the pipeline imports Stage 3 even for a Stage-1/2 run).
.venv-index/

