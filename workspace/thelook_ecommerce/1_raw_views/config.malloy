/// BRIDGE

-- source: bridge is bigquery.sql("""
--    SELECT  "events"      AS stage,
--    UNION ALL
--    SELECT  "order_items" AS stage
--    UNION ALL
--    SELECT 'users'       AS stage
-- """) 

source: bridge_raw is duckdb.sql("""
   SELECT 'events'      AS stage
   UNION ALL
   SELECT 'order_items' AS stage
   UNION ALL
   SELECT 'users'       AS stage
""")

