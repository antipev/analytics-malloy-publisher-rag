>>>markdown
# 📊 Business Pulse Dashboard
*This dashboard provides a high-level overview of e-commerce performance, including sales trends, user acquisition, and brand performance.*
>>>malloy
import '../../3_explores/ecommerce_explore.malloy'
>>>markdown
---

## 📈 Key Performance Indicators
These tiles represent our core top-line metrics for the current period.
>>>malloy
# dashboard
run: ecommerce_explore -> {
  where: order_items.Created_at.year = @2026
         AND 
         order_items.Status = 'Complete'
  aggregate: order_items.Order_Count
             order_items.Total_Revenue
             order_items.Average_Order_Value
             order_items.Order_Item_Count
             Gross_Markup_Percent
             Total_Gross_Margin
             Active_users is order_items.Total_Users

}
>>>malloy
# dashboard
run: ecommerce_explore -> {
  where: users.User_Created_at = @2026
  aggregate: New_users is users.Total_Users
             # percent
             goal_attainment is users.Total_Users / 39000
}
>>>markdown
---
### 📈 Orders by Day and Category
>>>malloy
# line_chart
run: ecommerce_explore -> {
  where: order_items.Created_at.year = @2026
         AND 
         order_items.Status = 'Complete'
  group_by:  created_month is order_items.Created_at.month::date::string
  aggregate: order_items.Order_Count
  order_by: created_month asc
}
>>>malloy
# line_chart
run: ecommerce_explore -> {
  where: order_items.Created_at.year = @2026
         AND 
         order_items.Status = 'Complete'
  group_by:  created_month is order_items.Created_at.month::date::string
  aggregate: order_items.Order_Item_Count
  order_by: created_month asc
}
>>>malloy
run: ecommerce_explore -> {
  where: order_items.Created_at = @2026
  group_by: inventory_items.Product_category
  aggregate: order_items.Order_Item_Count
  order_by: Order_Item_Count desc
  limit: 5
}
>>>malloy
# bar_chart
run: ecommerce_explore -> {
  where: order_items.Created_at.year = @2026
         AND 
         order_items.Status = 'Complete'
         AND
         inventory_items.Product_category = 'Jeans' | 'Top & Tees' | 'Swim' | 'Intimates' | 'Fashion Hoodies & Sweatshirts'
  group_by:  created_month is order_items.Created_at.month::date::string
             inventory_items.Product_category
  aggregate: order_items.Order_Item_Count
  order_by: created_month asc
}
>>>markdown
### 🏷️Top Brand Sales
>>>malloy
# table
run: ecommerce_explore -> {
  top: 10
  group_by: products.Brand
  aggregate: 
    products.`Count`
    order_items.Order_Count
    order_items.Order_Item_Count
  order_by: Order_Count desc
}
>>>markdown
---
### 👥 Marketing & Behavior
>>>malloy
# bar_chart
run: ecommerce_explore -> {
  where: events.Created_at.year = @2026
  group_by: 
    events.Traffic_source
  aggregate: events.User_Count
  order_by: User_Count desc
}
>>>malloy
# bar_chart
run: ecommerce_explore -> {
  group_by: order_items.User_Traffic_Source
  aggregate: order_items.Order_Item_Count
  where: order_items.Created_at ~ f`2026`
}