
import '../1_raw_views/config.malloy'

#(doc) "Granular inventory tracking for specific physical items, including cost and sale timestamps."
source: inventory_items is inventory_items_raw extend {

  primary_key: Id

  rename:
    #(doc) "Unique identifier for each specific item in the inventory."
    `Id`                             is id
    
    #(doc) "The acquisition cost of the specific inventory item."
    `Cost`                           is cost
    
    #(doc) "The timestamp when the item was added to the inventory."
    `Created_at`                     is created_at
    
    #(doc) "The brand name of the product associated with this inventory item."
    `Product_brand`                  is product_brand
    
    #(doc) "The category of the product associated with this inventory item."
    `Product_category`               is product_category
    
    #(doc) "The high-level department (e.g., Men, Women) of the associated product."
    `Product_department`             is product_department
    
    #(doc) "Foreign key referencing the distribution center where this specific item is located."
    `Product_distribution_center_id` is product_distribution_center_id
    
    #(doc) "Foreign key referencing the product definition."
    `Product_id`                     is product_id
    
    #(doc) "The full commercial name of the product."
    `Product_name`                   is product_name
    
    #(doc) "The retail price at which the product is listed for sale."
    `Product_retail_price`           is product_retail_price
    
    #(doc) "The unique Stock Keeping Unit identifier for the product."
    `Product_sku`                    is product_sku
    
    #(doc) "The timestamp when this specific inventory item was sold."
    `Sold_at`                        is sold_at

  measure: 
    #(doc) "The total number of unique items currently or previously in inventory."
    `Inventory_Count` is count()
    
    #(doc) "The total combined cost of the items in inventory."
    `Total Items Cost` is sum(Cost)
    
    #(doc) "The average cost across the selected inventory items."
    `Average Item Cost` is avg(Cost)


}