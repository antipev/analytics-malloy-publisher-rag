
import '../1_raw_views/config.malloy'

#(doc) "Warehouse and fulfillment locations for storing and distributing products."
source: distribution_centers is distribution_centers_raw extend {
 
  primary_key: Id

  rename: 
    #(doc) "Unique identifier for each distribution center."
    `Id`                            is id
    
    #(doc) "The GPS latitude coordinate of the distribution center location."
    `Latitude`                      is latitude
    
    #(doc) "The GPS longitude coordinate of the distribution center location."
    `Longitude`                     is longitude
    
    #(doc) "Distribution center name (e.g. 'Houston TX'). The human-readable label to group or rank by. Synonyms: warehouse, fulfillment center, DC, location."
    `Name`                          is name
    
    #(doc) "Geospatial point representation of the distribution center's location."
    `Distribution_Center_Geom`      is distribution_center_geom

  measure: 
    #(doc) "The total number of unique distribution centers."
    `Count` is count()

 
}